# EmailJS (https://www.emailjs.com) — powers the Contact and Carrier Signup forms.
# Both forms share the same template (fields: name, email, title, message).
# Create a free account, connect the Gmail inbox that should receive submissions,
# then fill in the IDs/key below.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Google Sheets — powers the carrier signup log and the public "Our Carriers"
# directory. One spreadsheet, two tabs, kept separate so the public site can
# never read applicant PII:
#
# 1. "Signups" tab — private, never published. Columns: Timestamp, Name,
#    Company, MC/DOT Number, Phone, Email, Truck Type, Home Base, Notes.
#    A small Apps Script "Web app" (bound to this spreadsheet — see
#    google-apps-script/carrier-signup.gs) appends a row here whenever the
#    carrier form is submitted. VITE_SHEETS_SIGNUP_URL is that Web app's URL.
#
# 2. "Carriers" tab — public. Columns: Company Name, Truck Type (optional),
#    Home Base (optional). Publish JUST this tab via File > Share > Publish
#    to web (choose the "Carriers" sheet, format CSV) — this does not expose
#    the Signups tab, even though it's the same file. VITE_SHEETS_DIRECTORY_
#    CSV_URL is that published link. To approve a carrier, add a row here
#    (after reviewing their entry in the Signups tab). To remove one, delete
#    the row — it disappears from the site immediately, no redeploy needed.

VITE_SHEETS_SIGNUP_URL=
VITE_SHEETS_DIRECTORY_CSV_URL=

# Publish only the Available Trucks tab as CSV, then paste its published URL.
VITE_SHEETS_TRUCKS_CSV_URL=
